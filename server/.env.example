# Copy to .env and fill in. Never commit the real .env.

# MongoDB connection string. Optional - without it the API still analyses logs,
# it just cannot persist alert history.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Base URL of the Python analysis service (no trailing slash).
ML_SERVICE_URL=https://logsentinenl-ml.onrender.com

# Port the API listens on. Hosting providers usually set this for you.
PORT=5000
